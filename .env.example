# =====================================================================
# 复制本文件为 .env 后按需修改。所有配置都集中在这一份文件里。
# =====================================================================

# ---------- 1. 知识库路径 ----------
# 你的 Obsidian Vault 绝对路径。项目只读它，绝不写入。
VAULT_PATH=C:/Users/30858/Documents/Obsidian Vault

# ---------- 2. 数据输出路径（相对项目根目录） ----------
DB_PATH=data/knowledge.db
CHROMA_PATH=data/chroma

# ---------- 3. 切块与检索参数 ----------
# 单个 chunk 的目标中文字符数（建议 500~1000）
CHUNK_SIZE=800
# 相邻 chunk 的重叠字符数，避免一句话被切在两段的交界处丢失上下文
CHUNK_OVERLAP=120
# 检索返回的最相关 chunk 数量
TOP_K=5

# ---------- 4. Embedding 配置 ----------
# local          = 本地离线伪向量（无需联网、无需 Key，只用于跑通链路和调试，不是真语义向量）
# local_semantic = 本地 sentence-transformers 模型（真语义、离线、推荐）
# openai         = 任意 OpenAI 兼容的 embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 仅 local 模式生效：伪向量维度
EMBEDDING_DIM=256

# ---------- 4b. 本地语义 Embedding（仅 EMBEDDING_PROVIDER=local_semantic 时生效） ----------
# 模型名。换模型改这里就行，不用动代码。
# 注意：换了模型之后旧向量必须重建，用 `python ingest.py --rebuild-vectors`
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# auto = 有 NVIDIA GPU 就用 CUDA，否则自动降级到 CPU；也可以显式写 cpu / cuda / mps
LOCAL_EMBEDDING_DEVICE=auto
# 需要"指令前缀"的模型在这里填（例如 BAAI/bge-large-zh-v1.5 要求查询前加指令）。
# BAAI/bge-m3 官方要求查询和文档都不加前缀，所以默认留空。
LOCAL_EMBEDDING_QUERY_PREFIX=
# 单条文本的 token 上限，超出会被截掉尾部。
# 这是显存上限，不是性能优化：encode 会把整批 pad 到批内最长那一条，
# attention 矩阵按 batch × heads × seq² 增长。本库实测最长 chunk 有 3654 token，
# batch=32 时那一批光 attention 就要 25 GB，6 GB 的显卡直接 OOM 挂死。
# 1024 只截尾 12 / 14303 条（0.08%），却把最坏情况锁死。
LOCAL_EMBEDDING_MAX_LENGTH=1024
# auto = CUDA 用 fp16（bge-m3 权重 2.17 GB → 约 1.1 GB），CPU 用 fp32。
# 也可以显式写 fp16 / fp32。注意：改了精度等于换了向量，必须重建索引。
LOCAL_EMBEDDING_DTYPE=auto
# 一次给模型的 chunk 数。别一次全塞 14303 条，会撑爆显存。
EMBEDDING_BATCH_SIZE=32

# ---------- 5. LLM 配置 ----------
# mock      = 本地回显（无需联网，只用于跑通 API 和看引用结构）
# openai    = 任意 OpenAI 兼容的 chat/completions 接口
# anthropic = Anthropic Messages API；凭证不填在这里，SDK 直接读进程的 ANTHROPIC_*
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- 6. 可选：关掉 Chroma 的匿名遥测 ----------
ANONYMIZED_TELEMETRY=False
