# =====================================================================
# 复制本文件为 .env 后按需修改。所有配置都集中在这一份文件里。
# =====================================================================

# ---------- 1. 知识库路径 ----------
# 你的 Obsidian Vault 绝对路径。项目只读它，绝不写入。
VAULT_PATH=C:/Users/30858/Documents/Obsidian Vault

# ---------- 2. 数据输出路径（相对项目根目录） ----------
DB_PATH=data/knowledge.db
CHROMA_PATH=data/chroma

# ---------- 3. 切块与检索参数 ----------
# 单个 chunk 的目标中文字符数（建议 500~1000）
CHUNK_SIZE=800
# 相邻 chunk 的重叠字符数，避免一句话被切在两段的交界处丢失上下文
CHUNK_OVERLAP=120
# 检索返回的最相关 chunk 数量
TOP_K=5

# ---------- 3b. Context 清洗（检索和 LLM 之间的一层） ----------
# 开启后流程变成：取 Top-20 → 剔除纯链接导航 chunk → 取 Top-5 → 清理 JSON 导出尾巴 → 拼 Prompt
# 默认关闭：保证随时能拿回"原始检索"的同一组数字。
# SQLite 里的 chunk 原文始终不动，/api/chat 返回的 sources 仍是原始 chunk。
CONTEXT_FILTER_ENABLED=False
# 开启清洗时先多取多少条候选，给过滤留余量
FILTER_RETRIEVE_TOP_K=20

# ---------- 3c. Reranker（实验性，默认关闭） ----------
# 开启后流程变成：检索 Top-50 → cross-encoder 重新打分排序 → 清洗 → Top-5
# 顺序是固定的（精排在前、清洗在后），因为精排要在完整候选池上重排。
#
# 默认 False 有两个原因，都不是"忘了开"：
#   1. 评估阶段必须随时能拿回"原始检索"的同一组数字，开关一开一关要能复现；
#   2. 加载模型要占约 1.1 GB 显存，不开就不该碰。
# 实测结论（见 RETRIEVAL_BASELINE.md 第 10 节）：召回类指标有真实改善，
# 但延迟从 40 ms 涨到几百毫秒量级。改这一行之前先读那段。
RERANKER_ENABLED=False
# 精排模型。中英双语，和 bge-m3 同家族（共享 XLM-RoBERTa 底座）。
# fp16 约 1.12 GB 权重、磁盘约 2.27 GB；首次运行会从 HF 下载。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 先取多少条粗排候选给精排打分。50 而不是 20，依据是 Top-50 深度测量
# 里期望文档的排名到 #33，用 20 会把它排除在池子外，精排救不回来。
RERANKER_CANDIDATE_TOP_K=50
# auto = 有 CUDA 用 CUDA，否则 CPU；也可以显式写 cpu / cuda / mps
RERANKER_DEVICE=auto
# auto = CUDA 用 fp16，CPU 用 fp32。注意：改精度会改变排序结果。
RERANKER_DTYPE=auto
# 单次 predict 的批量。cross-encoder 每对都要跑一遍完整 transformer，
# 激活内存远大于 bi-encoder。8 是实测值：6 GB 显存上 50 对峰值 2392 MiB，
# 余量约 3.7 GB；降到 4 只会更慢。
RERANKER_BATCH_SIZE=8

# ---------- 4. Embedding 配置 ----------
# local          = 本地离线伪向量（无需联网、无需 Key，只用于跑通链路和调试，不是真语义向量）
# local_semantic = 本地 sentence-transformers 模型（真语义、离线、推荐）
# openai         = 任意 OpenAI 兼容的 embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 仅 local 模式生效：伪向量维度
EMBEDDING_DIM=256

# ---------- 4b. 本地语义 Embedding（仅 EMBEDDING_PROVIDER=local_semantic 时生效） ----------
# 模型名。换模型改这里就行，不用动代码。
# 注意：换了模型之后旧向量必须重建，用 `python ingest.py --rebuild-vectors`
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# auto = 有 NVIDIA GPU 就用 CUDA，否则自动降级到 CPU；也可以显式写 cpu / cuda / mps
LOCAL_EMBEDDING_DEVICE=auto
# 需要"指令前缀"的模型在这里填（例如 BAAI/bge-large-zh-v1.5 要求查询前加指令）。
# BAAI/bge-m3 官方要求查询和文档都不加前缀，所以默认留空。
LOCAL_EMBEDDING_QUERY_PREFIX=
# 单条文本的 token 上限，超出会被截掉尾部。
# 这是显存上限，不是性能优化：encode 会把整批 pad 到批内最长那一条，
# attention 矩阵按 batch × heads × seq² 增长。本库实测最长 chunk 有 3654 token，
# batch=32 时那一批光 attention 就要 25 GB，6 GB 的显卡直接 OOM 挂死。
# 1024 只截尾 12 / 14303 条（0.08%），却把最坏情况锁死。
LOCAL_EMBEDDING_MAX_LENGTH=1024
# auto = CUDA 用 fp16（bge-m3 权重 2.17 GB → 约 1.1 GB），CPU 用 fp32。
# 也可以显式写 fp16 / fp32。注意：改了精度等于换了向量，必须重建索引。
LOCAL_EMBEDDING_DTYPE=auto
# 一次给模型的 chunk 数。别一次全塞 14303 条，会撑爆显存。
# 8 是实测值：RTX 4050 6GB + fp16 + max_length=1024 下 batch=8 峰值 1354 MiB，
# batch=16 只多 256 MiB 却几乎不提吞吐。照上面那段的推算 batch=32 会直接 OOM。
EMBEDDING_BATCH_SIZE=8

# ---------- 5. LLM 配置 ----------
# mock      = 本地回显（无需联网，只用于跑通 API 和看引用结构）
# openai    = 任意 OpenAI 兼容的 chat/completions 接口
# anthropic = Anthropic Messages API；凭证优先读下面的 LLM_API_KEY，
#             为空时回退到进程环境的 ANTHROPIC_AUTH_TOKEN
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 仅 anthropic provider 生效。anthropic SDK 默认是 connect=5.0s / timeout=600s，
# 这里覆盖成两个不同的值，因为管的是同一次请求的不同阶段：
#   LLM_TIMEOUT_CONNECT  连不连得上。给"真的连不上"时一个快速失败的上限。
#   LLM_TIMEOUT_TOTAL    等回答要多久。长 context 会占满这段，必须留足余量。
#
# 上游 LLM 延迟受服务负载、网络和时段影响较大。下面的数字来自一次历史测量，
# 不代表稳定表现，所以这里不写 benchmark 结果——只解释这两个值的含义。
# 需要新的延迟数字时跑：
#   python scripts/probe_llm_latency.py
# 建议在多个时段重复测量，再决定要不要改这两个值。两个值都保持可配置。
LLM_TIMEOUT_CONNECT=15
LLM_TIMEOUT_TOTAL=300

# ---------- 6. 可选：关掉 Chroma 的匿名遥测 ----------
ANONYMIZED_TELEMETRY=False
